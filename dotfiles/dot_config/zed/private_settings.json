// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Other
  "languages": {
    "Python": {
      "enable_language_server": true
    }
  },
  "format_on_save": "off",
  "cli_default_open_behavior": "new_window",
  "use_podman": true,

  // AI
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "flexible": true
  },

  // Style
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "fish",
        "args": [ "--login" ]
      }
    },
    "show_count_badge": false,
    "font_family": "MonaspiceAr Nerd Font Mono",
    "font_features": {
      "calt": true,
      "liga": true,
      "ss01": true,
      "ss02": true,
      "ss03": true,
      "ss04": true,
      "ss05": true,
      "ss06": true,
      "ss09": true,
      "ss10": true,
    },
  },

  // Editor style
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 300.0,
  "buffer_font_family": "Cascadia Code PL",
  "buffer_font_features": {
    "calt": true,
    "liga": true,
    "ss04": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss05": true,
    "ss06": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "One Dark"
  },
  "cursor_animation": {
    "enabled": true
  },
  "minimap": {
    "show": "always"
  },

  // Editor panels
  "collaboration_panel": {
    "button": false
  },
  "project_panel": {
    "sort_mode": "directories_first",
    "git_status_indicator": true,
    "bold_folder_labels": true
  }
}
