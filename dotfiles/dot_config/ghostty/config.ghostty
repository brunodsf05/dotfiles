command = SHELL=/usr/bin/fish /usr/bin/fish --login --interactive

# window-decoration = client
window-theme = ghostty

mouse-scroll-multiplier = 1

font-family = "MonaspiceAr Nerd Font Mono"
font-family-italic = "MonaspiceRn Nerd Font Mono"
font-family-bold-italic = "MonaspiceRn Nerd Font Mono"
font-feature = ss01,ss02,ss03,ss04,ss05,ss06,ss09,ss10,dlig,calt,liga

background = #000000
foreground = #b2b2b2

cursor-color = #b2b2b2
cursor-text = #111111
selection-background = #444444
selection-foreground = #ffffff

palette = 0=#111111
palette = 1=#e03030
palette = 2=#20d030
palette = 3=#e0a000
palette = 4=#0037e0
palette = 5=#b020b0
palette = 6=#30b0b0
palette = 7=#b2b2b2

palette = 8=#686868
palette = 9=#ff5757
palette = 10=#54ff54
palette = 11=#ffd92e
palette = 12=#0070f0
palette = 13=#ff54ff
palette = 14=#54ffff
palette = 15=#ffffff
